# Environment variables for VN-MDM Docker Compose
POSTGRES_USER=vnmdm
POSTGRES_PASSWORD=vnmdm_secure_password
POSTGRES_DB=vn_mdm_production

RAILS_ENV=production
SECRET_KEY_BASE=generate_with_rails_secret_token_at_least_64_characters_long

NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:3000

# Path to the source code on host
VNMDM_API_PATH=~/vn-mdm/api
VNMDM_WEB_PATH=~/vn-mdm/web
